@model CNPMFastFood.Models.ContactMessage
@inject CNPMFastFood.Services.SettingService SettingService

@{
    var setting = SettingService.GetSetting();
}

@{
    ViewData["Title"] = "Liên hệ";
}

<link rel="stylesheet"
      href="~/css/user/contact.css" />

<div class="container mt-5">

    <h1 class="text-center mb-3">&#128222; Liên hệ EscFood </h1>

    <p class="text-center text-muted mb-5">
        Chúng tôi luôn sẵn sàng hỗ trợ bạn. Hãy gửi câu hỏi hoặc góp ý cho chúng tôi!
    </p>

    <div class="row">

        <!-- CONTACT INFO -->
        <div class="col-md-5">
            <div class="card shadow-sm p-4 h-100">

                <h4 class="mb-4">&#128205; Thông tin cửa hàng</h4>

                <p>
                    <b>Địa chỉ:</b><br>
                    @setting.StoreAddress
                </p>

                <p>
                    <b>&#128222; Điện thoại:</b><br>
                    @setting.StorePhone
                </p>

                <p>
                    <b>&#9993; Email:</b><br>
                    @setting.StoreEmail
                </p>

                <p>
                    <b>&#128347; Giờ mở cửa:</b><br>
                    @setting.OpenTime - @setting.CloseTime
                </p>

            </div>
        </div>

        <!-- CONTACT FORM -->
        <div class="col-md-7">
            <div class="card shadow-sm p-4">

                <h4 class="mb-4">&#128233; Gửi tin nhắn EscFood</h4>

                @if(ViewBag.Success != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Success
                    </div>
                }

                <form asp-controller="Home" asp-action="Contact" method="post">

                    <div class="mb-3">
                        <label class="form-label">Họ và tên</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên của bạn">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Nhập email">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung</label>
                        <textarea asp-for="Message" class="form-control" rows="4" placeholder="Nhập nội dung liên hệ EscFood"></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">
                        Gửi liên hệ EscFood
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

<!-- GOOGLE MAP -->

<div class="container mt-5 mb-5">
    <div class="card shadow-sm">

        <iframe
            width="100%"
            height="350"
            style="border:0"
            loading="lazy"
            allowfullscreen
            src="https://maps.google.com/maps?q=ha%20noi&t=&z=13&ie=UTF8&iwloc=&output=embed">
        </iframe>

    </div>
</div>