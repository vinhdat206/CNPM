@model List<CNPMFastFood.Models.Product>

@section Styles {
<link rel="stylesheet" href="~/css/user/home.css" />
}

<div class="banner-section">
    <div class="swiper homeBannerSwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <img src="~/images/banners/banner1.png" class="banner-img" />
            </div>
            <div class="swiper-slide">
                <img src="~/images/banners/banner-new.png" class="banner-img" />
            </div>
            <div class="swiper-slide">
                <img src="~/images/banners/banner2.png" class="banner-img" />
            </div>
            <div class="swiper-slide">
                <img src="~/images/banners/banner3.png" class="banner-img" />
            </div>
        </div>

        <div class="swiper-button-prev banner-btn"></div>
        <div class="swiper-button-next banner-btn"></div>
        <div class="swiper-pagination banner-dots"></div>
    </div>
</div>

<div class="container mt-5">

    <h2 class="text-center mb-5 text-danger">
        Sản phẩm nổi bật
    </h2>

    @{
    var productGroups = Model != null
    ? Model.Select((product, index) => new { product, index })
    .GroupBy(x => x.index / 8)
    .Select(g => g.Select(x => x.product).ToList())
    .ToList()
    : new List<List<CNPMFastFood.Models.Product>>();
    }

    @if (productGroups.Any())
    {
    <div id="featuredCarousel" class="carousel slide featured-carousel" data-bs-ride="false">
        <div class="carousel-inner">

            @for (int g = 0; g < productGroups.Count; g++)
            {
            <div class="carousel-item @(g == 0 ? "active" : "")">
                <div class="featured-wrapper">
                    <div class="row">

                        @foreach (var item in productGroups[g])
                        {
                        <div class="col-lg-3 col-md-4 col-6 mb-4">
                            <div class="card product-card shadow-sm">

                                <div class="product-img"
                                     data-bs-toggle="modal"
                                     data-bs-target="#productModal-@item.Id"
                                     style="cursor:pointer;">
                                    <img src="@item.ImageUrl"
                                         class="img-fluid"
                                         alt="@item.Name" />
                                </div>

                                <hr />

                                <div class="card-body text-center">
                                    <h6>@item.Name</h6>

                                    <p class="text-danger fw-bold">
                                        @item.Price.ToString("N0") đ
                                    </p>

                                    <button type="button"
                                            class="buy-now-btn border-0"
                                            data-bs-toggle="modal"
                                            data-bs-target="#productModal-@item.Id">
                                        <i class="fa-solid fa-cart-plus"></i>
                                        Thêm vào giỏ
                                    </button>
                                </div>

                            </div>
                        </div>
                        }

                    </div>
                </div>
            </div>
            }

        </div>

        @if (productGroups.Count > 1)
        {
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#featuredCarousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#featuredCarousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
        }
    </div>

    @foreach (var item in Model)
    {
    <div class="modal fade" id="productModal-@item.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger">
                        @item.Name
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body text-center">

                    <img src="@item.ImageUrl"
                         class="img-fluid rounded mb-3"
                         style="max-height:250px;"
                         alt="@item.Name" />

                    <h4 class="fw-bold">@item.Name</h4>

                    @{
                    double avgRating = item.Reviews != null && item.Reviews.Any()
                    ? item.Reviews.Average(r => r.Rating)
                    : 0;

                    int reviewCount = item.Reviews != null
                    ? item.Reviews.Count
                    : 0;
                    }

                    <div class="mb-2 text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                        if (i <= Math.Round(avgRating))
                        {
                        <i class="fa-solid fa-star"></i>
                        }
                        else
                        {
                        <i class="fa-regular fa-star"></i>
                        }
                        }

                        <span class="text-dark ms-1">
                                    @avgRating.ToString("0.0")
                            (@reviewCount đánh giá)
                                </span>
                    </div>

                    <h5 class="text-danger fw-bold mb-3">
                        @item.Price.ToString("N0") đ
                    </h5>

                    <p class="text-muted">
                        @(string.IsNullOrEmpty(item.Description)
                        ? "Chưa có mô tả sản phẩm"
                        : item.Description)
                    </p>

                    @if (item.Reviews != null && item.Reviews.Any())
                    {
                    <div class="mt-4 text-start">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">
                                Feedback khách hàng
                            </h6>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#allReviewsModal-@item.Id">
                                Xem tất cả
                            </button>
                        </div>

                        @foreach (var review in item.Reviews.OrderByDescending(r => r.CreatedAt).Take(2))
                        {
                        <div class="border rounded p-3 mb-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@review.UserName</strong>
                                <small class="text-muted">
                                    @review.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <div class="text-warning mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                if (i <= review.Rating)
                                {
                                <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                <i class="fa-regular fa-star"></i>
                                }
                                }
                            </div>

                            <p class="mb-0 text-muted">
                                @review.Comment
                            </p>
                        </div>
                        }
                    </div>
                    }
                    else
                    {
                    <p class="text-muted mt-4">
                        Chưa có feedback nào.
                    </p>
                    }

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-4">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="decreaseQty(@item.Id, @item.Price)">
                            -
                        </button>

                        <input type="number"
                               id="qty-@item.Id"
                               value="1"
                               min="1"
                               class="form-control text-center"
                               style="width:80px;"
                               onchange="updateTotal(@item.Id, @item.Price)" />

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="increaseQty(@item.Id, @item.Price)">
                            +
                        </button>
                    </div>

                    <div class="mt-4">
                        <h5>
                            Tổng tiền:
                            <span class="text-danger fw-bold" id="total-@item.Id">
                                        @item.Price.ToString("N0") đ
                                    </span>
                        </h5>
                    </div>

                </div>

                <div class="modal-footer border-0">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                    <button type="button"
                            id="addCartBtn-@item.Id"
                            class="btn btn-danger w-100 add-to-cart-animate"
                            data-product-id="@item.Id"
                            data-name="@item.Name"
                            data-price="@item.Price"
                            data-image="@item.ImageUrl">
                        <i class="fa-solid fa-cart-plus"></i>
                        Xác nhận thêm vào giỏ
                    </button>
                    }
                    else
                    {
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-danger w-100">
                        Đăng nhập để thêm vào giỏ
                    </a>
                    }

                    <button type="button"
                            class="btn btn-secondary w-100"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="allReviewsModal-@item.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Tất cả đánh giá
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-toggle="modal"
                            data-bs-target="#productModal-@item.Id"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    @foreach (var review in item.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@review.UserName</strong>

                            <small class="text-muted">
                                @review.CreatedAt.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                            if (i <= review.Rating)
                            {
                            <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                            <i class="fa-regular fa-star"></i>
                            }
                            }
                        </div>

                        <p class="mb-0">
                            @review.Comment
                        </p>
                    </div>
                    }
                </div>

            </div>
        </div>
    </div>
    }
    }
    else
    {
    <p class="text-center text-muted">
        Chưa có sản phẩm nổi bật.
    </p>
    }

</div>

@section Scripts {
<script>
    function increaseQty(id, price) {
        let qtyInput = document.getElementById("qty-" + id);

        qtyInput.value = parseInt(qtyInput.value) + 1;

        updateTotal(id, price);
    }

    function decreaseQty(id, price) {
        let qtyInput = document.getElementById("qty-" + id);

        let currentQty = parseInt(qtyInput.value);

        if (currentQty > 1) {
            qtyInput.value = currentQty - 1;
        }

        updateTotal(id, price);
    }

    function updateTotal(id, price) {
        let qtyInput = document.getElementById("qty-" + id);
        let totalBox = document.getElementById("total-" + id);

        let qty = parseInt(qtyInput.value);

        if (isNaN(qty) || qty < 1) {
            qty = 1;
            qtyInput.value = 1;
        }

        let total = qty * price;

        totalBox.innerText = total.toLocaleString("vi-VN") + " đ";
    }

    function updateCartCount(count) {
        const cartCount = document.getElementById("cartCount");

        if (cartCount) {
            cartCount.innerText = count;
        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".add-to-cart-animate").forEach(btn => {

            btn.addEventListener("click", function (e) {
                e.preventDefault();

                const productId = this.dataset.productId;
                const name = this.dataset.name;
                const price = this.dataset.price;
                const imageUrl = this.dataset.image;

                const qtyInput = document.getElementById("qty-" + productId);
                const quantity = qtyInput ? qtyInput.value : 1;

                const modalEl = document.getElementById("productModal-" + productId);
                const modal = bootstrap.Modal.getInstance(modalEl);

                const productImg = modalEl.querySelector(".modal-body img");
                const cartIcon = document.getElementById("cartIcon");

                const formData = new FormData();

                formData.append("id", productId);
                formData.append("name", name);
                formData.append("price", price);
                formData.append("imageUrl", imageUrl);
                formData.append("quantity", quantity);

                fetch("/Cart/Add", {
                    method: "POST",
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            updateCartCount(data.count);
                        }
                    });

                if (!productImg || !cartIcon) {
                    if (modal) {
                        modal.hide();
                    }

                    return;
                }

                const imgRect = productImg.getBoundingClientRect();
                const cartRect = cartIcon.getBoundingClientRect();

                const flyImg = productImg.cloneNode(true);

                flyImg.style.position = "fixed";
                flyImg.style.left = imgRect.left + "px";
                flyImg.style.top = imgRect.top + "px";
                flyImg.style.width = imgRect.width + "px";
                flyImg.style.height = imgRect.height + "px";
                flyImg.style.zIndex = "9999";
                flyImg.style.pointerEvents = "none";
                flyImg.style.objectFit = "cover";
                flyImg.style.borderRadius = "50%";
                flyImg.style.transition = "all 0.8s ease-in-out";

                document.body.appendChild(flyImg);

                if (modal) {
                    modal.hide();
                }

                setTimeout(() => {
                    flyImg.style.left = cartRect.left + "px";
                    flyImg.style.top = cartRect.top + "px";
                    flyImg.style.width = "30px";
                    flyImg.style.height = "30px";
                    flyImg.style.opacity = "0.3";
                }, 50);

                setTimeout(() => {
                    flyImg.remove();
                }, 900);
            });

        });

        var homeBannerSwiper = new Swiper(".homeBannerSwiper", {
            loop: true,
            centeredSlides: true,
            slidesPerView: "auto",
            spaceBetween: 30,
            speed: 1000,

            autoplay: {
                delay: 3000,
                disableOnInteraction: false
            },

            pagination: {
                el: ".banner-dots",
                clickable: true
            },

            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev"
            },

            breakpoints: {
                0: {
                    slidesPerView: 1.05,
                    spaceBetween: 10
                },

                768: {
                    slidesPerView: 1.12,
                    spaceBetween: 18
                },

                1200: {
                    slidesPerView: "auto",
                    spaceBetween: 30
                }
            }
        });

    });
</script>
}