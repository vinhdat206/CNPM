@model CNPMFastFood.Models.ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đặt lại mật khẩu</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/user/register.css" />
</head>

<body>
<div class="register-container">
    <div class="register-card">

        <a asp-controller="Auth"
           asp-action="ForgotPassw"
           class="back-home-btn">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại 
        </a>

        <div class="logo-icon">
            <i class="fa-solid fa-lock"></i>
        </div>

        <h2>Đặt lại mật khẩu</h2>

        <p class="subtitle">
            Nhập mật khẩu mới của bạn
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="text-danger text-center mb-3">
                @ViewBag.Error
            </div>
        }

        <form method="post"
              asp-controller="Auth"
              asp-action="ResetPassword">

            <input asp-for="Email" type="hidden" />

            <div class="input-group">
                <label>Mật khẩu mới</label>

                <div class="input-box">
                    <i class="fas fa-lock"></i>

                    <input asp-for="NewPassword"
                           type="password"
                           placeholder="Nhập mật khẩu mới"
                           required
                           pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}$"
                           title="Ít nhất 8 ký tự, gồm chữ hoa, chữ thường và ký tự đặc biệt" />
                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>
            </div>

            <div class="input-group">
                <label>Xác nhận mật khẩu</label>

                <div class="input-box">
                    <i class="fas fa-lock"></i>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           placeholder="Xác nhận mật khẩu"
                           required />
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

            <button type="submit" class="register-btn">
                <i class="fas fa-key"></i>
                Đổi mật khẩu
            </button>

        </form>

    </div>
</div>
</body>
</html>