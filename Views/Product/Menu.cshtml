@model List<CNPMFastFood.Models.Product>

<h2>Menu</h2>

<a href="/Product/Create">Add Product</a>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>
                <a href="/Cart/Add?id=@item.Id&name=@item.Name&price=@item.Price">
                    Add to Cart
                </a>
            </td>
        </tr>
    }
</table>