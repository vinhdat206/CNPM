@using System.Linq
@model List<CNPMFastFood.Models.Product>

@{
ViewData["Title"] = "Sản phẩm";
}

@section Styles {
<link rel="stylesheet" href="~/css/user/product.css" />
}

<div class="product-page">

    <div class="product-header text-center">
        <h1>Sản phẩm</h1>
        <p>Khám phá các món ăn hấp dẫn tại FastFood</p>
    </div>

    <div id="categoryMenu" class="d-flex flex-wrap gap-2 justify-content-center mb-4">

        <a asp-action="Index" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == null ? "btn-danger" : "btn-outline-danger")">
            Tất cả
        </a>

        <a asp-action="Index" asp-route-categoryId="1" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 1 ? "btn-danger" : "btn-outline-danger")">Bánh mì</a>

        <a asp-action="Index" asp-route-categoryId="2" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 2 ? "btn-danger" : "btn-outline-danger")">Burger</a>

        <a asp-action="Index" asp-route-categoryId="3" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 3 ? "btn-danger" : "btn-outline-danger")">Đồ uống</a>

        <a asp-action="Index" asp-route-categoryId="4" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 4 ? "btn-danger" : "btn-outline-danger")">Khoai tây</a>

        <a asp-action="Index" asp-route-categoryId="5" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 5 ? "btn-danger" : "btn-outline-danger")">Gà chiên</a>

        <a asp-action="Index" asp-route-categoryId="6" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 6 ? "btn-danger" : "btn-outline-danger")">Gà rán</a>

        <a asp-action="Index" asp-route-categoryId="7" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 7 ? "btn-danger" : "btn-outline-danger")">Hot Dog</a>

        <a asp-action="Index" asp-route-categoryId="8" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 8 ? "btn-danger" : "btn-outline-danger")">Mì ly</a>

        <a asp-action="Index" asp-route-categoryId="9" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 9 ? "btn-danger" : "btn-outline-danger")">Pizza</a>

        <a asp-action="Index" asp-route-categoryId="10" asp-route-sortPrice="@ViewBag.SortPrice"
           class="ajax-link btn @(ViewBag.CategoryId == 10 ? "btn-danger" : "btn-outline-danger")">Sandwich</a>

    </div>

    <div id="filterBox" class="d-flex justify-content-end mb-4">

        <form asp-action="Index" method="get" id="sortForm">

            @if (ViewBag.CategoryId != null)
            {
            <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
            }

            <select name="sortPrice"
                    class="form-select form-select-sm"
                    style="width:220px;"
                    onchange="ajaxLoadFromUrl(buildSortUrl())">

                <option value="">Sắp xếp giá</option>

                @if (ViewBag.SortPrice == "asc")
                {
                <option value="asc" selected>Giá thấp đến cao</option>
                }
                else
                {
                <option value="asc">Giá thấp đến cao</option>
                }

                @if (ViewBag.SortPrice == "desc")
                {
                <option value="desc" selected>Giá cao đến thấp</option>
                }
                else
                {
                <option value="desc">Giá cao đến thấp</option>
                }

            </select>

        </form>

    </div>

    <div class="row" id="productList">

        @if (Model != null && Model.Any())
        {
        foreach (var item in Model)
        {
        double avgRating = item.Reviews != null && item.Reviews.Any()
        ? item.Reviews.Average(r => r.Rating)
        : 0;

        int reviewCount = item.Reviews != null
        ? item.Reviews.Count
        : 0;

        string imageUrl = string.IsNullOrEmpty(item.ImageUrl)
        ? "/images/no-image.png"
        : item.ImageUrl;

        <div class="col-lg-3 col-md-4 col-6 mb-4">

            <div class="card product-card shadow-sm">

                <div class="product-img"
                     data-bs-toggle="modal"
                     data-bs-target="#productModal-@item.Id"
                     style="cursor:pointer;">

                    <img src="@imageUrl" alt="@item.Name" class="img-fluid" />
                </div>

                <div class="card-body text-center">

                    <h6>@item.Name</h6>

                    <p class="price">
                        @item.Price.ToString("N0") đ
                    </p>

                    <button type="button"
                            class="buy-now-btn border-0"
                            data-bs-toggle="modal"
                            data-bs-target="#productModal-@item.Id"
                            @(item.Stock <= 0 ? "disabled" : "")>
                        <i class="fa-solid fa-cart-plus"></i>
                        @(item.Stock > 0 ? "Thêm vào giỏ" : "Hết hàng")
                    </button>

                </div>

            </div>

        </div>

        <div class="modal fade" id="productModal-@item.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold text-danger">
                            @item.Name
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body text-center">

                        <img src="@imageUrl"
                             class="img-fluid rounded mb-3"
                             style="max-height:250px;"
                             alt="@item.Name" />

                        <h4 class="fw-bold">@item.Name</h4>

                        <div class="mb-2 text-warning">

                            @for (int i = 1; i <= 5; i++)
                            {
                            if (i <= Math.Round(avgRating))
                            {
                            <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                            <i class="fa-regular fa-star"></i>
                            }
                            }

                            <span class="text-dark ms-1">
                                        @avgRating.ToString("0.0")
                                (@reviewCount đánh giá)
                                    </span>

                        </div>

                        <h5 class="text-danger fw-bold mb-3">
                            @item.Price.ToString("N0") đ
                        </h5>

                        <p class="text-muted">
                            @(string.IsNullOrEmpty(item.Description)
                            ? "Chưa có mô tả sản phẩm"
                            : item.Description)
                        </p>

                        @if (item.Reviews != null && item.Reviews.Any())
                        {
                        <div class="mt-4 text-start">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h6 class="fw-bold mb-0">
                                    Feedback khách hàng
                                </h6>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#allReviewsModal-@item.Id">
                                    Xem tất cả
                                </button>

                            </div>

                            @foreach (var review in item.Reviews.OrderByDescending(r => r.CreatedAt).Take(2))
                            {
                            <div class="border rounded p-3 mb-3 bg-light">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@review.UserName</strong>

                                    <small class="text-muted">
                                        @review.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <div class="text-warning mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                    if (i <= review.Rating)
                                    {
                                    <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                    <i class="fa-regular fa-star"></i>
                                    }
                                    }
                                </div>

                                <p class="mb-0 text-muted">
                                    @review.Comment
                                </p>

                            </div>
                            }

                        </div>
                        }
                        else
                        {
                        <p class="text-muted mt-4">
                            Chưa có feedback nào.
                        </p>
                        }

                        <div class="d-flex justify-content-center align-items-center gap-2 mt-4">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="decreaseQty(@item.Id, @item.Price, @item.Stock)"
                                    @(item.Stock <= 0 ? "disabled" : "")>
                                -
                            </button>

                            <input type="number"
                                   id="qty-@item.Id"
                                   value="@(item.Stock > 0 ? 1 : 0)"
                                   min="@(item.Stock > 0 ? 1 : 0)"
                                   max="@item.Stock"
                                   class="form-control text-center"
                                   style="width:80px;"
                                   onchange="updateTotal(@item.Id, @item.Price, @item.Stock)"
                                   @(item.Stock <= 0 ? "disabled" : "") />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="increaseQty(@item.Id, @item.Price, @item.Stock)"
                                    @(item.Stock <= 0 ? "disabled" : "")>
                                +
                            </button>

                        </div>

                        <div class="mt-4">
                            <h5>
                                Tổng tiền:
                                <span class="text-danger fw-bold"
                                      id="total-@item.Id">
                                            @(item.Stock > 0 ? item.Price.ToString("N0") + " đ" : "0 đ")
                                        </span>
                            </h5>
                        </div>

                    </div>

                    <div class="modal-footer border-0">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                        <button type="button"
                                id="addCartBtn-@item.Id"
                                class="btn btn-danger w-100 add-to-cart-animate"
                                data-product-id="@item.Id"
                                data-name="@item.Name"
                                data-price="@item.Price"
                                data-image="@imageUrl"
                                data-stock="@item.Stock"
                                @(item.Stock <= 0 ? "disabled" : "")>
                            <i class="fa-solid fa-cart-plus"></i>
                            @(item.Stock > 0 ? "Xác nhận thêm vào giỏ" : "Hết hàng")
                        </button>
                        }
                        else
                        {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-danger w-100">
                            Đăng nhập để thêm vào giỏ
                        </a>
                        }

                        <button type="button"
                                class="btn btn-secondary w-100"
                                data-bs-dismiss="modal">
                            Hủy
                        </button>

                    </div>

                </div>
            </div>
        </div>

        <div class="modal fade"
             id="allReviewsModal-@item.Id"
             tabindex="-1">

            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Tất cả đánh giá - @item.Name
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                onclick="showProductModal('@item.Id')">
                        </button>
                    </div>

                    <div class="modal-body">

                        @if (item.Reviews != null && item.Reviews.Any())
                        {
                        @foreach (var review in item.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                        <div class="border rounded p-3 mb-3">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@review.UserName</strong>

                                <small class="text-muted">
                                    @review.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <div class="text-warning mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                if (i <= review.Rating)
                                {
                                <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                <i class="fa-regular fa-star"></i>
                                }
                                }
                            </div>

                            <p class="mb-0">
                                @review.Comment
                            </p>

                        </div>
                        }
                        }
                        else
                        {
                        <p class="text-muted">
                            Chưa có đánh giá nào.
                        </p>
                        }

                    </div>

                </div>
            </div>

        </div>
        }
        }
        else
        {
        <div class="col-12 text-center">
            <p>Chưa có sản phẩm</p>
        </div>
        }

    </div>

    <div id="paginationBox">
        @if (ViewBag.TotalPages > 1)
        {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                    <a class="ajax-link page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-categoryId="@ViewBag.CategoryId"
                       asp-route-sortPrice="@ViewBag.SortPrice">
                        @i
                    </a>

                </li>
                }

            </ul>
        </nav>
        }
    </div>

</div>

@section Scripts {
<script>
    async function ajaxLoadFromUrl(url) {
        const response = await fetch(url, {
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        });

        const html = await response.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");

        const newCategoryMenu = doc.querySelector("#categoryMenu");
        const newFilterBox = doc.querySelector("#filterBox");
        const newProductList = doc.querySelector("#productList");
        const newPaginationBox = doc.querySelector("#paginationBox");

        if (newCategoryMenu) {
            document.querySelector("#categoryMenu").innerHTML =
                newCategoryMenu.innerHTML;
        }

        if (newFilterBox) {
            document.querySelector("#filterBox").innerHTML =
                newFilterBox.innerHTML;
        }

        if (newProductList) {
            document.querySelector("#productList").innerHTML =
                newProductList.innerHTML;
        }

        if (newPaginationBox) {
            document.querySelector("#paginationBox").innerHTML =
                newPaginationBox.innerHTML;
        }

        history.pushState({}, "", url);
    }

    function buildSortUrl() {
        const form = document.getElementById("sortForm");
        const formData = new FormData(form);
        const query = new URLSearchParams(formData).toString();

        return form.getAttribute("action") + "?" + query;
    }

    document.addEventListener("click", function (e) {
        const link = e.target.closest(".ajax-link");

        if (!link) {
            return;
        }

        e.preventDefault();

        ajaxLoadFromUrl(link.getAttribute("href"));
    });

    window.addEventListener("popstate", function () {
        ajaxLoadFromUrl(location.href);
    });

    function increaseQty(id, price, stock) {
        let qtyInput = document.getElementById("qty-" + id);

        let currentQty = parseInt(qtyInput.value);

        if (stock <= 0) {
            qtyInput.value = 0;
            updateTotal(id, price, stock);
            return;
        }

        if (currentQty >= stock) {
            alert(`Chỉ còn ${stock} sản phẩm`);
            qtyInput.value = stock;
            updateTotal(id, price, stock);
            return;
        }

        qtyInput.value = currentQty + 1;

        updateTotal(id, price, stock);
    }

    function decreaseQty(id, price, stock) {
        let qtyInput = document.getElementById("qty-" + id);

        let currentQty = parseInt(qtyInput.value);

        if (currentQty > 1) {
            qtyInput.value = currentQty - 1;
        }

        updateTotal(id, price, stock);
    }

    function updateTotal(id, price, stock) {
        let qtyInput = document.getElementById("qty-" + id);
        let totalBox = document.getElementById("total-" + id);

        let qty = parseInt(qtyInput.value);

        if (stock <= 0) {
            qty = 0;
            qtyInput.value = 0;
        }

        if (stock > 0 && (isNaN(qty) || qty < 1)) {
            qty = 1;
            qtyInput.value = 1;
        }

        if (stock > 0 && qty > stock) {
            qty = stock;
            qtyInput.value = stock;
            alert(`Chỉ còn ${stock} sản phẩm`);
        }

        let total = qty * price;

        totalBox.innerText = total.toLocaleString("vi-VN") + " đ";
    }

    function showProductModal(id) {
        setTimeout(() => {
            let productModal =
                new bootstrap.Modal(
                    document.getElementById(
                        "productModal-" + id
                    )
                );

            productModal.show();

        }, 200);
    }

    function updateCartCount(count) {
        const cartCount = document.getElementById("cartCount");

        if (cartCount) {
            cartCount.innerText = count;
        }
    }

    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".add-to-cart-animate");

        if (!btn) {
            return;
        }

        e.preventDefault();

        const productId = btn.dataset.productId;
        const name = btn.dataset.name;
        const price = btn.dataset.price;
        const imageUrl = btn.dataset.image;
        const stock = Number(btn.dataset.stock);

        const qtyInput = document.getElementById("qty-" + productId);
        const quantity = Number(qtyInput ? qtyInput.value : 1);

        if (stock <= 0) {
            alert("Sản phẩm đã hết hàng");
            return;
        }

        if (quantity > stock) {
            alert(`Chỉ còn ${stock} sản phẩm`);
            return;
        }

        const modalEl = document.getElementById("productModal-" + productId);
        const modal = bootstrap.Modal.getInstance(modalEl);

        const productImg = modalEl.querySelector(".modal-body img");
        const cartIcon = document.getElementById("cartIcon");

        const formData = new FormData();

        formData.append("id", productId);
        formData.append("name", name);
        formData.append("price", price);
        formData.append("imageUrl", imageUrl);
        formData.append("quantity", quantity);

        fetch("/Cart/Add", {
            method: "POST",
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    updateCartCount(data.count);
                } else {
                    alert(data.message || "Không thể thêm sản phẩm vào giỏ hàng");
                    return;
                }
            });

        if (!productImg || !cartIcon) {
            if (modal) {
                modal.hide();
            }

            return;
        }

        const imgRect = productImg.getBoundingClientRect();
        const cartRect = cartIcon.getBoundingClientRect();

        const flyImg = productImg.cloneNode(true);

        flyImg.style.position = "fixed";
        flyImg.style.left = imgRect.left + "px";
        flyImg.style.top = imgRect.top + "px";
        flyImg.style.width = imgRect.width + "px";
        flyImg.style.height = imgRect.height + "px";
        flyImg.style.zIndex = "9999";
        flyImg.style.pointerEvents = "none";
        flyImg.style.objectFit = "cover";
        flyImg.style.borderRadius = "50%";
        flyImg.style.transition = "all 0.8s ease-in-out";

        document.body.appendChild(flyImg);

        if (modal) {
            modal.hide();
        }

        setTimeout(() => {
            flyImg.style.left = cartRect.left + "px";
            flyImg.style.top = cartRect.top + "px";
            flyImg.style.width = "30px";
            flyImg.style.height = "30px";
            flyImg.style.opacity = "0.3";
        }, 50);

        setTimeout(() => {
            flyImg.remove();
        }, 900);
    });
</script>
}