@model List<CNPMFastFood.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>

        Giỏ hàng

    </title>

    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CART CSS -->

    <link rel="stylesheet"
          href="~/css/cart.css" />

</head>

<body>

<div class="cart-container">

    <!-- ================= HEADER ================= -->

    <div class="cart-header">

        <h1>

            <i class="fa-solid fa-cart-shopping"></i>

            Giỏ hàng của bạn

        </h1>

        <a href="/"
           class="back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Tiếp tục mua sắm

        </a>

    </div>

    <!-- ================= CART ITEMS ================= -->

    @if (Model.Count > 0)
    {
        <div class="cart-items">

            @foreach (var item in Model)
            {
                <!-- ITEM -->

                <div class="cart-item"
                     data-id="@item.Id">

                    <!-- IMAGE -->

                    <img src="@item.ImageUrl"
                         class="item-image" />

                    <!-- INFO -->

                    <div class="item-info">

                        <h3 class="item-name">

                            @item.Name

                        </h3>

                        <!-- PRICE -->

                        <p class="item-price">

                            @item.Price.ToString("N0") ₫

                        </p>

                    </div>

                    <!-- QUANTITY -->

                    <div class="quantity-control">

                        <!-- DECREASE -->

                        <button class="qty-btn decrease-btn">

                            -

                        </button>

                        <!-- QUANTITY -->

                        <span class="quantity">

                            @item.Quantity

                        </span>

                        <!-- INCREASE -->

                        <button class="qty-btn increase-btn">

                            +

                        </button>

                    </div>

                    <!-- SUBTOTAL -->

                    <div class="item-total">

                        @((item.Price * item.Quantity)
                            .ToString("N0")) ₫

                    </div>

                    <!-- REMOVE -->

                    <button class="remove-btn">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>
            }

        </div>

        <!-- ================= SUMMARY ================= -->

        <div class="cart-summary">

            <h2>

                Tổng cộng

            </h2>

            <div class="summary-row">

                <span>

                    Tổng tiền:

                </span>

                <!-- FIX FORMAT MONEY -->

                <strong id="totalPrice">

                    @(Model.Sum(x =>
                        x.Price * x.Quantity)
                        .ToString("N0")) ₫

                </strong>

            </div>

            <!-- CHECKOUT -->

            <a asp-controller="Order"
               asp-action="Checkout"
               class="checkout-btn">

                <i class="fa-solid fa-credit-card"></i>

                Thanh toán

            </a>

        </div>
    }
    else
    {
        <!-- ================= EMPTY CART ================= -->

        <div class="empty-cart">

            <i class="fa-solid fa-cart-shopping"></i>

            <h2>

                Giỏ hàng trống

            </h2>

            <p>

                Hãy thêm món ăn yêu thích của bạn

            </p>

        </div>
    }

</div>

<!-- ================= CART JS ================= -->

<script src="~/js/cart.js"></script>

</body>

</html>