@using Newtonsoft.Json
@using CNPMFastFood.Models
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FastFood</title>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- SITE CSS -->
    <link rel="stylesheet"
          href="~/css/site.css" />

    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @RenderSection("Styles", required: false)

</head>

<body>

<div id="toastBox" class="toast-box"></div>

<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">

    <div class="container">

        <!-- LOGO -->
        <a class="navbar-brand d-flex align-items-center"
           asp-controller="Home"
           asp-action="Index">

            <img src="~/images/Logo/Logo.PNG"
                 alt="FastFood Logo"
                 style="height:50px; margin-right:8px;">

            <span class="fw-bold text-danger">
                FastFood
            </span>

        </a>

        <!-- TOGGLE -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- MENU -->
        <div class="collapse navbar-collapse"
             id="navbarNav">

            <ul class="navbar-nav mx-auto main-menu">

                <!-- HOME -->
                <li class="nav-item">

                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString()=="Home"
                                         && ViewContext.RouteData.Values["Action"]?.ToString()=="Index"
                                         ? "active-menu" : "")"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="fa-solid fa-house"></i>

                        Trang chủ

                    </a>

                </li>

                <!-- ABOUT -->
                <li class="nav-item">

                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()=="About"
                                         ? "active-menu" : "")"
                       asp-controller="Home"
                       asp-action="About">

                        Giới thiệu

                    </a>

                </li>

                <!-- PRODUCT -->
                <li class="nav-item dropdown">

                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString()=="Menu"
                                         ? "active-menu" : "")"
                       asp-controller="Menu"
                       asp-action="Index">

                        Sản phẩm

                    </a>

                    <ul class="dropdown-menu">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Burger">

                                <i class="fa-solid fa-burger"></i>

                                Burger

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Pizza">

                                <i class="fa-solid fa-pizza-slice"></i>

                                Pizza

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Chicken">

                                <i class="fa-solid fa-drumstick-bite"></i>

                                Gà rán

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Drink">

                                <i class="fa-solid fa-wine-glass"></i>

                                Đồ uống

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Menu"
                               asp-action="Combo">

                                <i class="fa-solid fa-layer-group"></i>

                                Combo

                            </a>
                        </li>

                    </ul>

                </li>

                <!-- CONTACT -->
                <li class="nav-item">

                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()=="Contact"
                                         ? "active-menu" : "")"
                       asp-controller="Home"
                       asp-action="Contact">

                        Liên hệ

                    </a>

                </li>

                <!-- POLICY -->
                <li class="nav-item">

                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString()=="Policy"
                                         ? "active-menu" : "")"
                       asp-controller="Home"
                       asp-action="Policy">

                        Chính sách

                    </a>

                </li>

            </ul>

            <!-- ================= RIGHT SIDE ================= -->

            <div class="d-flex align-items-center">

                <!-- SEARCH -->
                <div class="search-wrapper me-3 position-relative">

                    <div class="search-box">

                        <input type="text"
                               id="searchInput"
                               placeholder="Tìm món..."
                               autocomplete="off" />

                        <button type="button">

                            <i class="fa-solid fa-magnifying-glass"></i>

                        </button>

                    </div>

                    <div id="searchResultBox"
                         class="search-result-box"></div>

                </div>

                <!-- CART -->
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="cart-icon me-3">

                    <i class="fa-solid fa-cart-shopping"
                       style="color:black;"></i>

                </a>

                <!-- ================= ACCOUNT ================= -->

                <div class="dropdown ms-2">

                    <a class="nav-link"
                       href="#"
                       id="accountDropdown"
                       role="button"
                       data-bs-toggle="dropdown">

                        <i class="fas fa-user-circle fs-5"></i>

                    </a>

                    <ul class="dropdown-menu">

                        @if (Context.Session.GetString("Username") == null)
                        {
                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Auth"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Auth"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }
                        else
                        {
                            <li>

                                <span class="dropdown-item text-danger">

                                    <i class="fa-solid fa-user"></i>

                                    @Context.Session.GetString("Username")

                                </span>

                            </li>

                            <li>

                                <a class="dropdown-item"
                                   href="/Order/History">

                                    <i class="fa-solid fa-box"></i>

                                    Lịch sử đơn

                                </a>

                            </li>

                            @if (Context.Session.GetString("Role") == "admin")
                            {
                                <li>

                                    <a class="dropdown-item"
                                       href="/Admin/Dashboard">

                                        <i class="fa-solid fa-user-gear"></i>

                                        Dashboard

                                    </a>

                                </li>
                            }

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Auth"
                                   asp-action="Logout">

                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>

                                    Logout

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </div>

    </div>

</nav>

<!-- ================= CONTENT ================= -->

<div class="container mt-4">

    @RenderBody()

</div>

<!-- ================= FOOTER ================= -->

<footer class="bg-dark text-white text-center mt-5 p-4">

    <p>© 2026 FastFood Restaurant</p>

    <p>Email: fastfood@gmail.com | Phone: 0123456789</p>

</footer>

<!-- ================= JS ================= -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

</body>

</html>