@model List<CNPMFastFood.Models.Order>

<h2>Order List</h2>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Order Date</th>
        <th>Total</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Id</td>
            <td>@order.OrderDate</td>
            <td>@order.TotalAmount</td>
            <td>@order.Status</td>
            <td>
                <a href="/Order/UpdateStatus?id=@order.Id&status=Completed">
                    Complete
                </a>
            </td>
        </tr>
    }
</table>