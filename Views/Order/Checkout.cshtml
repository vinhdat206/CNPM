@model CNPMFastFood.Models.Cart

@{
    ViewData["Title"] = "Thanh toán";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Thanh toán
    </title>

    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CHECKOUT CSS -->

    <link rel="stylesheet"
          href="~/css/checkout.css" />

</head>

<body>

<div class="checkout-container">

    <!-- =========================
         TITLE
    ========================= -->

    <h2 class="checkout-title">

        <i class="fa-solid fa-credit-card"></i>

        Thanh toán đơn hàng

    </h2>

    <!-- =========================
         FORM
    ========================= -->

    <form method="post"
          asp-action="PlaceOrder"
          asp-controller="Order"
          class="checkout-form">

        <!-- =========================
             CUSTOMER NAME
        ========================= -->

        <div>

            <label>
                Họ tên khách hàng
            </label>

            <input type="text"
                   name="CustomerName"
                   placeholder="Nhập họ tên"
                   required />

        </div>

        <!-- =========================
             PHONE
        ========================= -->

        <div>

            <label>
                Số điện thoại
            </label>

            <input type="text"
                   name="Phone"
                   placeholder="Nhập số điện thoại"
                   required />

        </div>

        <!-- =========================
             ADDRESS
        ========================= -->

        <div>

            <label>
                Địa chỉ giao hàng
            </label>

            <input type="text"
                   name="Address"
                   placeholder="Nhập địa chỉ"
                   required />

        </div>
        
        <!-- =========================
        PAYMENT METHOD
        ========================= -->

        <div class="payment-method">

            <label class="payment-title">
                Phương thức thanh toán
            </label>

            <!-- COD -->

            <div class="payment-option">

               

                <label for="cod">

                    <i class="fa-solid fa-money-bill-wave"></i>

                    Thanh toán khi nhận hàng (COD)

                </label>
                
                <input type="radio"
                       id="cod"
                       name="PaymentMethod"
                       value="COD"
                       checked />
                

            </div>

        </div>


        <!-- =========================
             PRODUCT TABLE
        ========================= -->

        <table class="checkout-table">

            <thead>

                <tr>

                    <th>Hình ảnh</th>

                    <th>Sản phẩm</th>

                    <th>Số lượng</th>

                    <th>Giá</th>

                    <th>Thành tiền</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <!-- IMAGE -->

                        <td>

                            <img src="@item.ImageUrl"
                                 class="checkout-image" />

                        </td>

                        <!-- NAME -->

                        <td>
                            @item.Name
                        </td>

                        <!-- QUANTITY -->

                        <td>
                            @item.Quantity
                        </td>

                        <!-- PRICE -->

                        <td>
                            @item.Price.ToString("N0") ₫
                        </td>

                        <!-- TOTAL -->

                        <td>
                            @((item.Price * item.Quantity)
                                .ToString("N0")) ₫
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <!-- =========================
             TOTAL
        ========================= -->

        <div class="total-box">

            <div>
                Giá sản phẩm:
                <strong>
                    @Model.SubTotal.ToString("N0") ₫
                </strong>
            </div>

            <div>
                Phí ship:
                <strong>
                    @Model.ShippingFee.ToString("N0") ₫
                </strong>
            </div>

            <hr />

            <div>
                Tổng tiền:
                <strong>
                    @Model.GrandTotal.ToString("N0") ₫
                </strong>
            </div>

        </div>

        
        <!-- =========================
             BUTTON
        ========================= -->

        <button type="submit"
                class="checkout-btn">

            <i class="fa-solid fa-check"></i>

            Đặt hàng ngay

        </button>

    </form>

</div>

</body>

</html>