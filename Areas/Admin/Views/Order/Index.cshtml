@model List<CNPMFastFood.Models.Order>
@inject CNPMFastFood.Services.SettingService SettingService

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var setting = SettingService.GetSetting();
}

@section Styles{
    <link rel="stylesheet" href="~/css/admin/order.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-bordered table-hover align-middle">

    <thead class="table-dark">
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Thanh toán</th>
            <th width="220">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@order.TotalAmount.ToString("N0") đ</td>

                <td>
                    @switch (order.Status)
                    {
                        case "Pending":
                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                            break;
                        case "Processing":
                            <span class="badge bg-primary">Đang xử lý</span>
                            break;
                        case "Shipping":
                            <span class="badge bg-info text-dark">Đang giao</span>
                            break;
                        case "Completed":
                            <span class="badge bg-success">Hoàn thành</span>
                            break;
                        case "Cancelled":
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@order.Status</span>
                            break;
                    }
                </td>

                <td>
                    @if (order.Status == "Completed")
                    {
                        <span class="badge bg-success">Đã thanh toán</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                    }
                </td>

                <td class="d-flex gap-2">
                    <button class="btn btn-info btn-sm"
                            title="Chi tiết"
                            data-bs-toggle="modal"
                            data-bs-target="#detailModal-@order.Id">
                        <i class="bi bi-eye-fill"></i>
                    </button>

                    <button class="btn btn-warning btn-sm"
                            title="Cập nhật trạng thái"
                            data-bs-toggle="modal"
                            data-bs-target="#statusModal-@order.Id">
                        <i class="bi bi-pencil-square"></i>
                    </button>

                    <button class="btn btn-danger btn-sm"
                            title="Hủy đơn"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelModal-@order.Id">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>

                    <button class="btn btn-dark btn-sm"
                            title="Xóa đơn"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal-@order.Id">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>

</table>

@foreach (var order in Model)
{
    var productTotal = order.OrderDetails != null
        ? order.OrderDetails.Sum(x => x.Price * x.Quantity)
        : 0;

    var shippingFee = setting.ShippingFee;

    <!-- DETAIL MODAL -->

    <div class="modal fade"
         id="detailModal-@order.Id"
         tabindex="-1">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Chi tiết đơn hàng #@order.Id
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <p>
                        <b>Khách hàng:</b>
                        @order.CustomerName
                    </p>

                    <p>
                        <b>SĐT:</b>
                        @order.Phone
                    </p>

                    <p>
                        <b>Địa chỉ:</b>
                        @order.Address
                    </p>

                    <p>
                        <b>Ngày đặt:</b>
                        @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <b>Phương thức thanh toán:</b>
                        @(string.IsNullOrEmpty(order.PaymentMethod) ? "COD" : order.PaymentMethod)
                    </p>

                    <p>
                        <b>Trạng thái:</b>

                        @switch (order.Status)
                        {
                            case "Pending":
                                <span>Chờ xử lý</span>
                                break;

                            case "Processing":
                                <span>Đang xử lý</span>
                                break;

                            case "Shipping":
                                <span>Đang giao</span>
                                break;

                            case "Completed":
                                <span>Hoàn thành</span>
                                break;

                            case "Cancelled":
                                <span class="text-danger">Đã hủy</span>

                                @if (!string.IsNullOrEmpty(order.CancelReason))
                                {
                                    <div class="mt-2">
                                        <b>Lý do hủy:</b>

                                        <div class="text-muted">
                                            @order.CancelReason
                                        </div>
                                    </div>
                                }

                                break;

                            default:
                                <span class="badge bg-secondary">
                                    @order.Status
                                </span>
                                break;
                        }
                    </p>

                    <p>
                        <b>Tình trạng thanh toán:</b>

                        @if (order.Status == "Completed")
                        {
                            <span class="badge bg-success">Đã thanh toán</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                        }
                    </p>

                    <p>
                        <b>Sản phẩm:</b>
                        @productTotal.ToString("N0") đ
                    </p>

                    <p>
                        <b>Phí ship:</b>

                        <span class="fw-bold text-primary">
                            @shippingFee.ToString("N0") đ
                        </span>
                    </p>

                    <p>
                        <b>Tổng tiền:</b>

                        <span class="fw-bold text-danger fs-5">
                            @order.TotalAmount.ToString("N0") đ
                        </span>
                    </p>

                    <hr />

                    <h5>Sản phẩm</h5>

                    @if (order.OrderDetails != null && order.OrderDetails.Any())
                    {
                        <table class="table table-bordered">

                            <thead>
                                <tr>
                                    <th>Ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Giá</th>
                                    <th>Phí ship</th>
                                    <th>SL</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <tr>
                                        <td width="80">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl"
                                                     class="product-image"
                                                     alt="@item.ProductName" />
                                            }
                                            else
                                            {
                                                <span>Không có ảnh</span>
                                            }
                                        </td>

                                        <td>@item.ProductName</td>
                                        <td>@item.Price.ToString("N0") đ</td>
                                        <td>@shippingFee.ToString("N0") đ</td>
                                        <td>@item.Quantity</td>

                                        <td>
                                            @((item.Price * item.Quantity + shippingFee).ToString("N0")) đ
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            Không có sản phẩm
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- STATUS MODAL -->

    <div class="modal fade"
         id="statusModal-@order.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-area="Admin"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5>Cập nhật trạng thái</h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               value="@order.Id" />

                        <select name="status"
                                class="form-select">

                            <option value="Pending">Chờ xử lý</option>
                            <option value="Processing">Đang xử lý</option>
                            <option value="Shipping">Đang giao</option>
                            <option value="Completed">Hoàn thành</option>

                        </select>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Đóng
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Lưu
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- CANCEL MODAL -->

    <div class="modal fade"
         id="cancelModal-@order.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-area="Admin"
                      asp-controller="Order"
                      asp-action="Cancel"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5>Hủy đơn hàng</h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               value="@order.Id" />

                        <p>
                            Bạn có chắc muốn hủy đơn hàng
                            <b>#@order.Id</b> ?
                        </p>

                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Lý do hủy
                            </label>

                            <textarea name="cancelReason"
                                      class="form-control"
                                      rows="4"
                                      required
                                      placeholder="Nhập lý do hủy đơn hàng..."></textarea>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Không
                        </button>

                        <button type="submit"
                                class="btn btn-danger">
                            Hủy đơn
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- DELETE MODAL -->

    <div class="modal fade"
         id="deleteModal-@order.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-area="Admin"
                      asp-controller="Order"
                      asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5>Xóa đơn hàng</h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               value="@order.Id" />

                        Bạn có chắc muốn xóa đơn hàng
                        <b>#@order.Id</b> ?

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Hủy
                        </button>

                        <button type="submit"
                                class="btn btn-dark">
                            Xóa
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}