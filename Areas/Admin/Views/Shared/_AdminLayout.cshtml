@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var currentArea =
        ViewContext.RouteData.Values["area"]?.ToString();

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Admin
    </title>

    <!-- BOOTSTRAP -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- FONT AWESOME -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          rel="stylesheet" />

    <!-- ADMIN CSS -->

    <link rel="stylesheet"
          href="~/css/admin/dashboard.css" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <!-- SIDEBAR -->

    <nav class="sidebar">

        <div class="logo">

            <i class="fas fa-chart-line"></i>

            <span>Dashboard</span>

        </div>

        <div class="menu">

            <!-- DASHBOARD -->

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Dashboard" ? "active" : "")">

                <i class="fas fa-home"></i>

                <span>Tổng quan</span>

            </a>

            <!-- PRODUCT -->

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Product" ? "active" : "")">

                <i class="fas fa-box"></i>

                <span>Sản phẩm</span>

            </a>

            <!-- ORDER -->

            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Order" ? "active" : "")">

                <i class="fas fa-shopping-cart"></i>

                <span>Đơn hàng</span>

            </a>

            <!-- FEEDBACK -->

            <a asp-area="Admin"
               asp-controller="Feedback"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Feedback" ? "active" : "")">

                <i class="fas fa-star"></i>

                <span>Feedback</span>

            </a>
            
            <!--KHÁCH HÀNG-->
            <a asp-area="Admin"
               asp-controller="Customer"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Customer" ? "active" : "")">

                <i class="fas fa-users"></i>

                <span>Khách hàng</span>

            </a>

            <!-- CONTACT -->

            <a asp-area="Admin"
               asp-controller="Contact"
               asp-action="Index"
               class="menu-item @(currentArea == "Admin" && currentController == "Contact" ? "active" : "")">

                <i class="fas fa-envelope"></i>

                <span>Liên hệ</span>

            </a>

            <!-- REPORT -->

            <a asp-area="Admin"
               asp-controller="Report"
               asp-action="Index"
               class="menu-item">

                <i class="fas fa-chart-bar"></i>

                <span>Báo cáo</span>

            </a>

            <!-- SETTING -->

            <a asp-area="Admin"
               asp-controller="Setting"
               asp-action="Index"
               class="menu-item">

                <i class="fas fa-cog"></i>

                <span>Cài đặt</span>

            </a>

            <!-- LOGOUT -->

            <form asp-area=""
                  asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="logout-form">

                @Html.AntiForgeryToken()

                <button type="submit" class="menu-item logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Đăng xuất</span>
                </button>

            </form>

        </div>

    </nav>

    <!-- MAIN -->

    <main class="main">

        <!-- HEADER -->

        <div class="header">

            <h1>
                @ViewData["PageTitle"]
            </h1>

            <div class="user-info">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="switch-view-btn">

                    <i class="fas fa-globe"></i>

                    User View

                </a>

                <span>
                    Xin chào,
                    <strong>Admin</strong>
                </span>

                <div class="user-avatar">
                    A
                </div>

            </div>

        </div>

        <!-- BODY -->

        @RenderBody()

    </main>

    <!-- CHART JS -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- BOOTSTRAP JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- PAGE SCRIPTS -->

    @RenderSection("Scripts", required: false)

    <!-- ADMIN JS -->

    <script src="~/js/admin/dashboard.js"></script>

</body>

</html>