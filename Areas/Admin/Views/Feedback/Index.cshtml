@model List<CNPMFastFood.Models.Product>

@{
    ViewData["Title"] = "Quản lý feedback";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/feedback.css" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <input type="text"
           id="searchProduct"
           class="form-control"
           placeholder="Tìm kiếm theo tên sản phẩm..." />
</div>

<table class="table table-bordered align-middle shadow-sm" id="feedbackTable">
    <thead class="table-dark">
        <tr>
            <th width="120">Ảnh</th>
            <th width="250">Sản phẩm</th>
            <th>Feedback</th>
            <th width="160">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            var reviews = product.Reviews?
                .OrderByDescending(x => x.CreatedAt)
                .ToList()
                ?? new List<CNPMFastFood.Models.Review>();

            var latest = reviews.FirstOrDefault();

            <tr class="product-row">
                <td class="text-center">
                    <img src="@product.ImageUrl"
                         alt="@product.Name"
                         class="product-img" />
                </td>

                <td>
                    <div class="product-name">
                        @product.Name
                    </div>
                </td>

                <td>
                    @if (latest == null)
                    {
                        <span class="text-muted">Chưa có feedback</span>
                    }
                    else
                    {
                        <div class="review-preview">
                                    <strong>@latest.UserName</strong>
        
                                    <span class="text-warning ms-2">
                                        @for (int i = 1; i <= latest.Rating; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                    </span>
        
                                    <div class="comment">
                                        @latest.Comment
                                    </div>
        
                                    <small class="date d-block">
                                        @latest.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
        
                                    @if (reviews.Count > 1)
                                    {
                                        <div class="text-primary fw-bold mt-1">
                                            +@(reviews.Count - 1) feedback nữa...
                                        </div>
                                    }
                                </div>
                    }
                </td>

                <td class="text-center">
                    <button class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#feedbackModal_@product.Id">
                        <i class="fas fa-eye"></i>
                        Xem tất cả
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@foreach (var product in Model)
{
    var reviews = product.Reviews?
        .OrderByDescending(x => x.CreatedAt)
        .ToList()
        ?? new List<CNPMFastFood.Models.Review>();

    <div class="modal fade" id="feedbackModal_@product.Id" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        Feedback của @product.Name
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    @if (!reviews.Any())
                    {
                        <div class="alert alert-warning">
                            Sản phẩm này chưa có feedback.
                        </div>
                    }
                    else
                    {
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Người đánh giá</th>
                                    <th>Số sao</th>
                                    <th>Bình luận</th>
                                    <th>Ngày đánh giá</th>
                                    <th width="120">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var review in reviews)
                                {
                                    <tr>
                                        <td>@review.UserName</td>

                                        <td>
                                            <span class="text-warning">
                                                @for (int i = 1; i <= review.Rating; i++)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                            </span>
                                        </td>

                                        <td>@review.Comment</td>

                                        <td>
                                            @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            <form asp-area="Admin"
                                                  asp-controller="Feedback"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa feedback này?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@review.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash"></i>
                                                    Xóa
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById("searchProduct").addEventListener("keyup", function () {
            let keyword = this.value.toLowerCase();
            let rows = document.querySelectorAll("#feedbackTable tbody .product-row");

            rows.forEach(function (row) {
                let productName = row.querySelector(".product-name").innerText.toLowerCase();

                row.style.display = productName.includes(keyword) ? "" : "none";
            });
        });
    </script>
}