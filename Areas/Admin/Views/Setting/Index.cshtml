@* ========================================
   FILE: Areas/Admin/Views/Setting/Index.cshtml
   ======================================== *@

@{
// Tiêu đề tab trình duyệt
ViewData["Title"] = "Cài đặt";

// Tiêu đề hiển thị ở header admin layout
ViewData["PageTitle"] = "Cài đặt hệ thống";
}

@* CSS riêng cho trang Cài đặt *@
@section Styles {
<link rel="stylesheet" href="~/css/admin/setting.css" />
}

@* Thông báo sau khi lưu thành công *@
@if (TempData["Success"] != null)
{
<div class="setting-alert">
    <i class="fas fa-check-circle"></i>
    @TempData["Success"]
</div>
}

@* Form gửi dữ liệu về SettingController/Save *@
<form asp-area="Admin"
      asp-controller="Setting"
      asp-action="Save"
      method="post">

    <div class="setting-grid">

        @* =============================
           THÔNG TIN CỬA HÀNG
           ============================= *@

        <div class="setting-card">
            <div class="setting-card-header">
                <i class="fas fa-store"></i>
                <h3>Thông tin cửa hàng</h3>
            </div>

            <div class="form-group">
                <label>Tên cửa hàng</label>
                <input type="text"
                       name="StoreName"
                       value="@ViewBag.StoreName" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email"
                       name="StoreEmail"
                       value="@ViewBag.StoreEmail" />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text"
                       name="StorePhone"
                       value="@ViewBag.StorePhone" />
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <textarea name="StoreAddress">@ViewBag.StoreAddress</textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Giờ mở cửa</label>
                    <input type="time"
                           name="OpenTime"
                           value="@ViewBag.OpenTime" />
                </div>

                <div class="form-group">
                    <label>Giờ đóng cửa</label>
                    <input type="time"
                           name="CloseTime"
                           value="@ViewBag.CloseTime" />
                </div>
            </div>
        </div>

        @* =============================
           CÀI ĐẶT ĐƠN HÀNG
           ============================= *@

        <div class="setting-card">
            <div class="setting-card-header">
                <i class="fas fa-receipt"></i>
                <h3>Cài đặt đơn hàng</h3>
            </div>

            <div class="form-group">
                <label>Phí giao hàng</label>
                <input type="number"
                       name="ShippingFee"
                       value="@ViewBag.ShippingFee" />
            </div>

            <div class="form-group">
                <label>Đơn hàng tối thiểu</label>
                <input type="number"
                       name="MinimumOrderAmount"
                       value="@ViewBag.MinimumOrderAmount" />
            </div>

            <div class="form-group">
                <label>Thời gian giao dự kiến</label>
                <input type="number"
                       name="EstimatedDeliveryMinutes"
                       value="@ViewBag.EstimatedDeliveryMinutes" />

                <small>Đơn vị: phút</small>
            </div>
        </div>

        @* =============================
           CÀI ĐẶT THANH TOÁN
           ============================= *@

        <div class="setting-card">
            <div class="setting-card-header">
                <i class="fas fa-credit-card"></i>
                <h3>Cài đặt thanh toán</h3>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>Thanh toán khi nhận hàng</strong>
                    <p>Cho phép khách hàng thanh toán COD</p>
                </div>

                <label class="switch">
                    <input type="checkbox"
                           name="IsCodEnabled"
                           checked="@ViewBag.IsCodEnabled" />

                    <span class="slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <div>
                    <strong>Chuyển khoản ngân hàng</strong>
                    <p>Cho phép khách hàng thanh toán chuyển khoản</p>
                </div>

                <label class="switch">
                    <input type="checkbox"
                           name="IsBankTransferEnabled"
                           checked="@ViewBag.IsBankTransferEnabled" />

                    <span class="slider"></span>
                </label>
            </div>
        </div>

        @* =============================
           TÀI KHOẢN ADMIN
           ============================= *@

        <div class="setting-card">
            <div class="setting-card-header">
                <i class="fas fa-user-shield"></i>
                <h3>Tài khoản admin</h3>
            </div>

            <div class="form-group">
                <label>Mật khẩu hiện tại</label>
                <input type="password"
                       name="CurrentPassword"
                       placeholder="Nhập mật khẩu hiện tại" />
            </div>

            <div class="form-group">
                <label>Mật khẩu mới</label>
                <input type="password"
                       name="NewPassword"
                       placeholder="Nhập mật khẩu mới" />
            </div>

            <div class="form-group">
                <label>Xác nhận mật khẩu mới</label>
                <input type="password"
                       name="ConfirmNewPassword"
                       placeholder="Nhập lại mật khẩu mới" />
            </div>
        </div>

    </div>

    @* Nút thao tác *@
    <div class="setting-actions">
        <button type="reset" class="btn-cancel">
            <i class="fas fa-rotate-left"></i>
            Hủy
        </button>

        <button type="submit" class="btn-save">
            <i class="fas fa-save"></i>
            Lưu cài đặt
        </button>
    </div>

</form>

@* JS riêng cho trang Cài đặt *@
@section Scripts {
<script src="~/js/admin/setting.js"></script>
}